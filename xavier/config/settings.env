# Settings for install.sh, uninstall.sh and the scripts. Edit, then re-run
# install.sh. No addresses here: this machine's private address is discovered
# from Tailscale, and CogyServer's is given to install.sh with --allow-from.

# Services. cogy-vera runs vera/vera.py on PORT. cogy-vera-model runs
# llama-server on 127.0.0.1:MODEL_PORT. cogy-vera-firewall holds the firewall
# rule.
SERVICE_NAME=cogy-vera
MODEL_SERVICE_NAME=cogy-vera-model
FIREWALL_SERVICE_NAME=cogy-vera-firewall
SERVICE_USER=cogy-vera

# Install locations. Code on the root disk, source and model on the NVMe.
PREFIX=/opt/cogy-vera
DATA_DIR=/models/cogy-vera
LOG_DIR=/var/log/cogy-vera

# API
PORT=8811
MODEL_PORT=18811

# llama.cpp, built for this GPU (Carmel CPU, Volta GPU, CUDA 11.4)
LLAMA_REPO=https://github.com/ggml-org/llama.cpp.git
LLAMA_COMMIT=a4cb4c61fd9d9c2066c7c1747821d3d65b8943bd
CUDA_ARCH=72
NVCC=/usr/local/cuda/bin/nvcc
CMAKE_VERSION=3.31.6
CMAKE_SHA256=42d9883b8958da285d53d5f69d40d9650c2d1bcf922d82b3ebdceb2b3a7d4521

# Model
MODEL_ID=ggml-org/Qwen3.6-35B-A3B-Q4_K_M
MODEL_REPO=ggml-org/Qwen3.6-35B-A3B-GGUF
MODEL_REVISION=7878dc9a905c7c9379e5e8d6a1aa9affdd6839c5
MODEL_FILE=Qwen3.6-35B-A3B-Q4_K_M.gguf
MODEL_SHA256=671e47e0ec53c665d048b98c3ecbfd5236b5ca9c3e02ed19fc8f81f7b85140c7

# How the model is served
CONTEXT=65536                   # tokens per request (prompt plus output)
PARALLEL=2                      # requests served at once
GPU_LAYERS=99                   # all of them
BATCH=2048
UBATCH=512
CACHE_RAM=1024                  # MiB of prompt cache in RAM
MAX_TOKENS=4000                 # per verdict
TIMEOUT=1800                    # seconds Vera waits for one model reply

# The model cannot load if another model is holding the GPU's memory.
REQUIRED_MEMORY_MB=23000
CONFLICTING_SERVICES="cogy-system1.service"
